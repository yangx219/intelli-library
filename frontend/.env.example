# Copy this file to `.env` (same folder as package.json), fill values, restart `npm run dev`.
# Dashboard: Project Settings → API Keys → Project URL + Publishable (or anon) key.
# Run repo file ../supabase/sql/saved_books.sql once in Supabase SQL Editor for Save buttons.
#
# URL must look like: https://YOUR_PROJECT_REF.supabase.co  — do NOT add /rest/v1/

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional production: Django API public URL if frontend is on another domain (no trailing slash).
# Leave empty when nginx/Caddy serves /api on the same origin as the static site.
# VITE_API_BASE=https://api.yourdomain.com
#
# OpenAI keys live only on the Django host (.env at repo root or library/). Never put API keys in VITE_*.
